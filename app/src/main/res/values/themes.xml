        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
    </style>
    <style name="Theme.VKTea.AudioPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="teaVkBlue">@color/vk_blue</item>
        <item name="teaBrandBar">@color/brand_bar</item>
        <item name="teaSurface">@color/surface</item>
        <item name="teaSurfaceSecondary">@color/surface_secondary</item>
