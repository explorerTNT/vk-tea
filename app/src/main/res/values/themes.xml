<resources>
    <style name="Theme.VKTea.PhotoViewer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
    </style>
    <style name="Theme.VKTea.AudioPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/audio_accent</item>
        <item name="colorSurface">@color/audio_surface</item>
        <item name="android:colorBackground">@color/audio_surface</item>
        <item name="android:colorBackgroundFloating">@color/audio_surface</item>
        <item name="android:colorAccent">@color/audio_accent</item>
        <item name="android:statusBarColor">@color/audio_artwork</item>
        <item name="android:navigationBarColor">@color/vk_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/audio_surface</item>
    </style>
    <style name="Theme.VKTea.AudioExport" parent="Theme.VKTea.AudioPlayer">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="Theme.VKTea" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vk_blue</item>
        <item name="colorPrimaryDark">@color/brand_bar</item>
        <item name="android:statusBarColor">@color/brand_bar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ThemeOverlay.VKTea.Toolbar" parent="ThemeOverlay.Material3.Dark">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="toolbarStyle">@style/Widget.VKTea.Toolbar</item>
    </style>

    <style name="Widget.VKTea.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.VKTea.Toolbar.Title</item>
        <item name="android:background">@color/brand_bar</item>
        <item name="titleTextColor">@android:color/white</item>
    </style>

    <style name="TextAppearance.VKTea.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="ButtonAction">
        <item name="android:textSize">14sp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">5.5dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">7.5dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ButtonAction.Blue">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:background">@drawable/blue_button</item>
    </style>

    <style name="ButtonAction.Gray">
        <item name="android:textColor">@color/button_gray_text</item>
        <item name="android:background">@drawable/white_button</item>
        <item name="android:minWidth">85dp</item>
    </style>
</resources>
