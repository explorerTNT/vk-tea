<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/viewer_top"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/viewer_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/photo_viewer_back"
            android:padding="12dp"
            android:src="@drawable/photo_viewer_back" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/viewer_counter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/viewer_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/photo_viewer_more"
            android:padding="12dp"
            android:src="@drawable/photo_viewer_more" />
    </LinearLayout>

    <com.vktea.feed.PhotoDismissLayout
        android:id="@+id/viewer_middle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/photo_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/viewer_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_margin="8dp"
            android:background="@drawable/photo_viewer_round_button"
            android:contentDescription="@string/photo_viewer_previous"
            android:padding="12dp"
            android:src="@drawable/photo_viewer_previous" />

        <ImageButton
            android:id="@+id/viewer_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_margin="8dp"
            android:background="@drawable/photo_viewer_round_button"
            android:contentDescription="@string/photo_viewer_next"
            android:padding="12dp"
            android:src="@drawable/photo_viewer_next" />
    </com.vktea.feed.PhotoDismissLayout>

    <LinearLayout
        android:id="@+id/viewer_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/viewer_like"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/photo_viewer_like"
            app:drawableStartCompat="@drawable/photo_viewer_like"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp"
            android:padding="4dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/viewer_comments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/photo_viewer_comments"
            app:drawableStartCompat="@drawable/photo_viewer_comments"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp"
            android:padding="4dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/viewer_repost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/photo_viewer_repost"
            app:drawableStartCompat="@drawable/photo_viewer_repost"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="56dp"
            android:padding="4dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
