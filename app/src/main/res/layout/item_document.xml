<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground" android:focusable="true">
    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp"
        android:src="@drawable/ic_profile_counter_documents" app:tint="@color/vk_blue" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/document_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textColor="@color/almost_black" android:textSize="16sp" />
        <TextView android:id="@+id/document_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="3dp" android:textColor="@color/post_time" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
