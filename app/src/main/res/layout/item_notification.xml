<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="top" android:orientation="horizontal">
        <ImageView android:id="@+id/notification_avatar" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginEnd="16dp" android:scaleType="centerCrop" android:src="@drawable/chat_avatar_placeholder"
            android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/notification_actor" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/almost_black" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/notification_action" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="@color/post_time" android:textSize="14sp" />
            <TextView android:id="@+id/notification_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="@color/almost_black" android:textSize="14sp" />
            <TextView android:id="@+id/notification_parent" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/post_time" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" />
            <TextView android:id="@+id/notification_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/post_time" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="80dp"
        android:background="@color/post_divider" />
</LinearLayout>
