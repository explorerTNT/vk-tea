<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/chat_voice_play_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:padding="4dp"
        android:src="@drawable/chat_voice_play" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/chat_attachment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#384A5C"
            android:textSize="14sp" />
        <SeekBar
            android:id="@+id/chat_voice_progress"
            android:layout_width="128dp"
            android:layout_height="48dp"
            android:contentDescription="@string/chat_voice_seek"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:splitTrack="false"
            android:thumb="@drawable/chat_voice_thumb" />
        <TextView
            android:id="@+id/chat_attachment_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/post_time"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
