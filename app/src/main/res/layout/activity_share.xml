<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/share_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vk_blue"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/share_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/vk_blue"
        app:navigationContentDescription="@string/share_back"
        app:navigationIcon="@drawable/photo_viewer_back"
        app:title="@string/share_title"
        app:titleTextColor="#FFFFFF" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/share_viewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/share_attachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:textColor="#8A8A8A"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/share_destinations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="@string/share_choose_destination"
                    android:textColor="#2E3033"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/share_own_wall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="56dp"
                    android:text="@string/share_own_wall"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/share_community"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="56dp"
                    android:text="@string/share_community_wall"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/share_friends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="56dp"
                    android:text="@string/share_friends"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/share_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="56dp"
                    android:text="@string/share_dialog"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/share_permission_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="@string/share_not_repostable"
                    android:textColor="#6D7885"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/share_targets_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/share_targets_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#2E3033"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/share_query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/share_search"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:textColor="#2E3033"
                    android:textColorHint="#8A8A8A"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/share_loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_margin="12dp" />

                <TextView
                    android:id="@+id/share_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="#6D7885"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/share_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/share_retry"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/share_targets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/share_confirmation_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/share_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="16dp"
                    android:textColor="#2E3033"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/share_draft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="8"
                    android:minLines="3"
                    android:textColor="#2E3033"
                    android:textColorHint="#8A8A8A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/share_confirm_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="#6D7885"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/share_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/share_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAllCaps="false" />
    </FrameLayout>
</LinearLayout>
