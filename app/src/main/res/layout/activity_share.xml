<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/share_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/share_header_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share_back"
            android:padding="12dp"
            android:src="@drawable/photo_viewer_back"
            android:visibility="gone"
            app:tint="@color/post_time" />

        <TextView
            android:id="@+id/share_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:text="@string/share_title"
            android:textColor="@color/almost_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/share_header_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share_search"
            android:padding="12dp"
            android:src="@drawable/share_sheet_search"
            app:tint="#909499" />
    </LinearLayout>

    <com.vktea.share.SharePanelScrollView
        android:id="@+id/share_viewport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/share_destinations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/share_recent_targets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="116dp"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/share_recent_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/post_time"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/share_recent_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:minHeight="48dp"
                    android:text="@string/share_retry"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/share_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_secondary"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/share_more_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <Button
                    android:id="@+id/share_friends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/share_friends"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/share_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/share_dialog"
                    android:textAllCaps="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/share_targets_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/share_targets_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/almost_black"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/share_query"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/share_search"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:minHeight="48dp"
                    android:singleLine="true"
                    android:textColor="@color/almost_black"
                    android:textColorHint="@color/post_time"
                    android:textSize="16sp" />
                <ProgressBar
                    android:id="@+id/share_loading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_margin="12dp" />
                <TextView
                    android:id="@+id/share_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/post_time"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/share_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/share_retry"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/share_targets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/share_confirmation_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/share_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:textColor="@color/almost_black"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/share_draft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minLines="2"
                    android:textColor="@color/almost_black"
                    android:textColorHint="@color/post_time"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/share_confirm_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textColor="@color/post_time"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </com.vktea.share.SharePanelScrollView>

    <FrameLayout
        android:id="@+id/share_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:visibility="gone">
        <Button
            android:id="@+id/share_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAllCaps="false" />
    </FrameLayout>
</LinearLayout>
