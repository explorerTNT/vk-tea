<?xml version="1.0" encoding="utf-8"?>
<!-- 1:1 с Coffee: profile_post_buttons.xml (две кнопки 48dp с вертикальным разделителем) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_post_buttons"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/profile_add_post"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/profile_add_post_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:drawableStart="@drawable/ic_profile_new_post"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/profile_new_post"
            android:textColor="#FF6C737A"
            android:textSize="14sp" />
    </FrameLayout>

    <View
        android:layout_width="0.5dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:background="#FFD7D8D9" />

    <FrameLayout
        android:id="@+id/profile_add_photo"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:drawableStart="@drawable/ic_profile_post_photo"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/profile_add_photo"
            android:textColor="#FF6C737A"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
