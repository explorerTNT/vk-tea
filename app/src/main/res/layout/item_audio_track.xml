<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/audio_list_current"
        android:layout_width="16dp"
        android:layout_height="20dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/audio_list_current_track"
        android:src="@drawable/audio_list_equalizer"
        android:visibility="gone"
        app:tint="?attr/teaAudioAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/audio_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="?attr/teaAudioText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/audio_track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="?attr/teaAudioSecondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/audio_list_local"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/audio_list_local_file"
        android:src="@drawable/audio_list_local"
        android:visibility="gone"
        app:tint="?attr/teaAudioAccent" />

    <TextView
        android:id="@+id/audio_list_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="?attr/teaAudioSecondary"
        android:textSize="12sp" />
</LinearLayout>
