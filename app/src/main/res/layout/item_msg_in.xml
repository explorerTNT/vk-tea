<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/msg_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/msg_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="?attr/teaPostTime" android:textSize="12sp" android:visibility="gone" />
    <com.vktea.msg.ChatMessageRow android:id="@+id/msg_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start|bottom" android:orientation="horizontal" android:paddingStart="2dp" android:paddingEnd="12dp">
        <ImageView android:id="@+id/msg_sender_photo" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom" android:layout_marginEnd="6dp" android:layout_marginBottom="2dp" android:contentDescription="@null" android:scaleType="centerCrop" android:src="@drawable/chat_avatar_placeholder" />
        <LinearLayout android:id="@+id/msg_wrap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="54dp" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="6dp">
            <TextView android:id="@+id/msg_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:breakStrategy="simple" android:hyphenationFrequency="none" android:fontFamily="sans-serif" android:includeFontPadding="false" android:textColor="?attr/teaChatBubbleText" android:textSize="16sp" />
            <LinearLayout android:id="@+id/msg_attachments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
            <TextView android:id="@+id/msg_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:includeFontPadding="false" android:paddingTop="3dp" android:textColor="?attr/teaPostTime" android:textSize="11sp" />
        </LinearLayout>
    </com.vktea.msg.ChatMessageRow>
</LinearLayout>
