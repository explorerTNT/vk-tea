<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/cover_frame"
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <ImageView
            android:id="@+id/cover_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_profile_cover" />

        <View
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="top"
            android:alpha="0.5"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="bottom"
            android:alpha="0.5"
            android:background="@drawable/scrim_bottom" />

        <TextView
            android:id="@+id/profile_last_seen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:fontFamily="sans-serif"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:singleLine="true"
            android:textColor="#d9ffffff"
            android:textSize="12sp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/profile_avatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="-48dp"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@null"
        android:elevation="4dp"
        android:padding="3dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/profile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/almost_black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/profile_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:textColor="@color/post_time"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/profile_buttons_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="8dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/profile_btn_message"
            style="@style/ButtonAction.Blue"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/message" />

        <Button
            android:id="@+id/profile_btn_friend"
            style="@style/ButtonAction.Gray"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:ellipsize="end"
            android:minWidth="85dp"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/profile_counters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp" />
</LinearLayout>
