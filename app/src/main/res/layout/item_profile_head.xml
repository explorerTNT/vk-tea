<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profile_head"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical">

    <include layout="@layout/item_profile_cover" />

    <LinearLayout
        android:id="@+id/profile_buttons_wrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="8dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/profile_btn_message"
            style="@style/ButtonAction.Blue"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/message" />

        <Button
            android:id="@+id/profile_btn_friend"
            style="@style/ButtonAction.Gray"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="8dp"
            android:ellipsize="end"
            android:minWidth="85dp"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/profile_counters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp" />
</LinearLayout>
