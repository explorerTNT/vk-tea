<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@android:color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/post_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/post_header_btn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignTop="@id/post_avatar"
            android:layout_alignBottom="@id/post_avatar"
            android:layout_alignLeft="@id/post_avatar"
            android:layout_marginRight="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/post_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="12dp"
                android:singleLine="true"
                android:textColor="@color/post_name"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/post_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingLeft="12dp"
                android:singleLine="true"
                android:textColor="@color/post_time"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/post_options"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="10dp"
            android:layout_marginRight="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_card_actions" />
    </RelativeLayout>

    <TextView
        android:id="@+id/post_collapse_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/feed_collapse"
        android:textColor="@color/vk_blue"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:visibility="gone" />

    <com.vktea.feed.FeedPostContent
        android:id="@+id/post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/post_content_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <TextView
        android:id="@+id/post_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="@color/almost_black"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/post_repost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/repost_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/repost_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_retweet"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/post_time"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/post_name"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/repost_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/post_time"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/repost_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingTop="4dp"
            android:textColor="@color/almost_black"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/repost_photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/post_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/video_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="#66000000"
            android:contentDescription="@null"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/exo_controls_play" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/post_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/post_photos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    </LinearLayout>
    </com.vktea.feed.FeedPostContent>

    <TextView
        android:id="@+id/post_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/feed_show_full"
        android:textColor="@color/vk_blue"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <View
            android:id="@+id/post_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="7.5dp"
            android:layout_marginRight="16dp"
            android:background="@color/post_divider" />

        <TextView
            android:id="@+id/post_likes"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:drawableLeft="@drawable/ic_like_24dp"
            android:drawablePadding="6dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/post_comments"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_toRightOf="@id/post_likes"
            android:drawableLeft="@drawable/ic_comment_24dp"
            android:drawablePadding="6dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/post_reposts"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_toRightOf="@id/post_comments"
            android:drawableLeft="@drawable/ic_share_24dp"
            android:drawablePadding="6dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/post_views"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:drawableLeft="@drawable/ic_viewers_24dp"
            android:drawablePadding="6dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="16sp" />
    </RelativeLayout>

    <TextView
        android:id="@+id/post_show_comments"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:drawableLeft="@drawable/ic_comment_24dp"
        android:drawablePadding="6dp"
        android:drawableTint="@color/vk_blue"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:textColor="@color/vk_blue"
        android:textSize="15sp"
        android:visibility="gone" />

</LinearLayout>
