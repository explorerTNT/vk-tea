<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/post_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/post_header_btn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignTop="@id/post_avatar"
            android:layout_alignBottom="@id/post_avatar"
            android:layout_alignLeft="@id/post_avatar"
            android:layout_marginRight="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingRight="16dp">

            <TextView
                android:id="@+id/post_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="12dp"
                android:singleLine="true"
                android:textColor="@color/post_name"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/post_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:paddingLeft="12dp"
                android:singleLine="true"
                android:textColor="@color/post_time"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_marginTop="10dp"
            android:layout_marginRight="4dp"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_card_actions" />
    </RelativeLayout>

    <TextView
        android:id="@+id/post_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textColor="@color/almost_black"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/post_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <View
            android:id="@+id/post_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="7.5dp"
            android:layout_marginRight="16dp"
            android:background="@color/post_divider" />

        <TextView
            android:id="@+id/post_views"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="16dp"
            android:drawableLeft="@drawable/ic_viewers_24dp"
            android:drawablePadding="4dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/post_likes"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentRight="true"
            android:drawableLeft="@drawable/ic_like_24dp"
            android:drawablePadding="4dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/post_comments"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_toLeftOf="@id/post_likes"
            android:drawableLeft="@drawable/ic_comment_24dp"
            android:drawablePadding="4dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/post_reposts"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_toLeftOf="@id/post_comments"
            android:drawableLeft="@drawable/ic_share_24dp"
            android:drawablePadding="4dp"
            android:drawableTint="@color/post_icons"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="18dp"
            android:textColor="@color/post_icons"
            android:textSize="15sp" />
    </RelativeLayout>

</LinearLayout>
