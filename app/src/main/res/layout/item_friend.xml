<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="?attr/selectableItemBackground" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
        android:paddingStart="16dp" android:paddingEnd="4dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="16dp">
            <ImageView android:id="@+id/friend_avatar" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:src="@drawable/chat_avatar_placeholder" android:contentDescription="@null" />
            <View android:id="@+id/friend_online" android:layout_width="14dp" android:layout_height="14dp"
                android:layout_gravity="bottom|end" android:background="@drawable/friends_online_dot" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/friend_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/almost_black" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/friend_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textColor="@color/post_time" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/friend_message" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="4dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_messages" app:tint="@color/vk_blue" android:scaleType="center"
            android:contentDescription="@string/friends_message" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_marginStart="80dp"
        android:background="@color/post_divider" />
</LinearLayout>
