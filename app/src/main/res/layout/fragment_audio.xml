<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/teaAudioSurface"
    android:orientation="vertical">

    <TextView
        android:id="@+id/audio_list_shuffle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:drawableStart="@drawable/audio_list_shuffle"
        android:drawablePadding="16dp"
        android:drawableTint="?attr/teaAudioAccent"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/audio_list_shuffle_all"
        android:textColor="?attr/teaAudioAccent"
        android:textSize="16sp" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="?attr/teaAudioDivider" />

    <LinearLayout
        android:id="@+id/audio_list_message_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/audio_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:padding="16dp"
            android:textColor="?attr/teaAudioSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/audio_list_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/audio_list_retry"
            android:textColor="?attr/teaAudioAccent"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/audio_list_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/audio_queue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/audio_list_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/audio_list_loading"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="16dp"
                    android:indeterminateTint="?attr/teaAudioAccent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/audio_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/audio_list_empty"
                    android:textColor="?attr/teaAudioSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/audio_list_load_more"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/audio_list_load_more"
        android:textColor="?attr/teaAudioAccent"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
